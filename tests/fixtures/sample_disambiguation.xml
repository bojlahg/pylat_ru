<?xml version="1.0" encoding="utf-8"?>
<!--
Sample Russian Disambiguation Rules for Unit Testing
-->
<rules lang="ru" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../../../../../../../languagetool-core/src/main/resources/org/languagetool/resource/disambiguation.xsd">

    <rulegroup name="TEST_DISAMBIG_GROUP" id="TEST_DISAMBIG_GROUP">
        <rule name="Remove Tag Rule">
            <pattern>
                <token>слово</token>
                <marker>
                    <token postag="NOUN.*" postag_regexp="yes"/>
                </marker>
            </pattern>
            <disambig action="remove"><wd lemma="слово" postag="VERB.*"/></disambig>
            <example type="untouched">Просто слово.</example>
        </rule>
        <rule name="Add Tag Rule with Filter">
            <pattern>
                <token>тест</token>
            </pattern>
            <filter class="org.languagetool.rules.ru.NoDisambiguationRussianPartialPosTagFilter" args="postag:TEST"/>
            <disambig action="add"><wd lemma="тест" postag="TEST_TAG"/></disambig>
        </rule>
    </rulegroup>
</rules>
