* text=auto eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf
*.dict binary
*.info text eol=lf

# Vendored upstream assets are byte-exact provenance artifacts.
# Do not normalize their line endings on checkout or commit.
third_party/languagetool/** -text
